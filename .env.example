# Example environment variables for local development.
# Copy to `.dev.vars` and fill in real values; `.dev.vars` is git-ignored.
# For production, set secrets with `wrangler secret put <NAME>` instead.

# Required: pepper for session ids and password derivation.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: legacy single OpenAI key. If set, it becomes one provider named
# "OpenAI". Prefer AI_PROVIDERS (below) or the in-app Settings → AI providers UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional: a JSON array of AI providers. Takes precedence over OPENAI_API_KEY
# when the database has none configured. Supported kinds:
#   "openai"             → OpenAI hosted API (base defaults to api.openai.com/v1)
#   "openai-compatible"  → Chutes, Groq, OpenRouter, self-hosted vLLM/SGLang…
#   "ollama"             → local/remote Ollama (native /api/chat)
# Example (Chutes cloud Ollama models):
# AI_PROVIDERS=[{"id":"chutes-gpt-oss","name":"Chutes gpt-oss:120b","kind":"openai-compatible","baseUrl":"https://llm.chutes.ai/v1","apiKey":"YOUR_KEY","model":"gpt-oss:120b","isDefault":true},{"id":"chutes-gemma4","name":"Chutes gemma4:31b","kind":"openai-compatible","baseUrl":"https://llm.chutes.ai/v1","apiKey":"YOUR_KEY","model":"gemma4:31b"}]
AI_PROVIDERS=
