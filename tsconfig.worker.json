{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/worker/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"],
  // The brand test renders client React components and reads repo files, so it
  // runs under vitest (node) only and is intentionally outside the Worker types.
  "exclude": ["tests/unit/brand.test.ts"]
}
